# Copy this file to .streamlit/secrets.toml for local dev (never commit the real one).
# On Streamlit Community Cloud, paste these same keys into
# App settings -> Secrets instead of using this file.

R2_ACCESS_KEY_ID = "your-access-key-id"
R2_SECRET_ACCESS_KEY = "your-secret-access-key"
R2_ENDPOINT_URL = "https://<account_id>.r2.cloudflarestorage.com"
R2_BUCKET_NAME = "follow-the-money"
